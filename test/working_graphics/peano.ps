%!
% Peano curve.
% By John Fouhy.

% Accuracy limits in postscript start hitting around maxdepth 6 or 7 (at least, with gv 3.5.8).

0 setlinewidth
/maxx 600 def
/maxy 768 def % initial coordinate axis lengths

% Change this to change the recursion depth.
/maxdepth 4 def

/procs [ /zero /one /two /three /four /five ] bind def % array of functions

/zero {
    /depth exch def
    depth maxdepth ge
    {
        newpath 0 -1 1 90 180 arc stroke
        -1 -1 translate
        90 rotate
    }
    {
        1 3 div dup scale % go to 1/3 scale
        /newdepth depth 1 add def % increment depth

        newdepth procs 5 get % get the name of the first subcomponent
        cvx exec % make it executable, then exec it

        newdepth procs 0 get
        cvx exec

        newdepth procs 1 get
        cvx exec

        newdepth procs 2 get
        cvx exec

        3 dup scale % rescale again

        /newdepth newdepth 1 sub def
        
    } ifelse
} def

/one {
    /depth exch def
    depth maxdepth ge
    {
        newpath 0 -1 1 90 180 arc stroke
        -1 -1 translate
        90 rotate
    }
    {
        1 3 div dup scale
        /newdepth depth 1 add def

        newdepth procs 3 get cvx exec
        newdepth procs 0 get cvx exec
        newdepth procs 1 get cvx exec
        newdepth procs 5 get cvx exec

        /newdepth newdepth 1 sub def
        3 dup scale
    } ifelse
} def

/two {
    /depth exch def
    depth maxdepth ge
    {
        newpath 0 1 1 180 270 arc stroke
        -1 1 translate
        270 rotate
    }
    {
        1 3 div dup scale
        /newdepth depth 1 add def

        newdepth procs 0 get cvx exec
        newdepth procs 3 get cvx exec
        newdepth procs 2 get cvx exec
        newdepth procs 4 get cvx exec

        /newdepth newdepth 1 sub def
        3 dup scale
    } ifelse
} def

/three {
    /depth exch def
    depth maxdepth ge
    {
        newpath 0 1 1 180 270 arc stroke
        -1 1 translate
        270 rotate
    }
    {
        1 3 div dup scale
        /newdepth depth 1 add def

        newdepth procs 4 get cvx exec
        newdepth procs 3 get cvx exec
        newdepth procs 2 get cvx exec
        newdepth procs 1 get cvx exec

        /newdepth newdepth 1 sub def
        3 dup scale
    } ifelse
} def

/four {
    /depth exch def
    depth maxdepth ge
    {
        newpath 0 0 moveto -2 0 lineto stroke
        -2 0 translate
    }
    {
        1 3 div dup scale
        /newdepth depth 1 add def

        newdepth procs 3 get cvx exec
        newdepth procs 0 get cvx exec
        newdepth procs 1 get cvx exec
        newdepth procs 2 get cvx exec

        /newdepth newdepth 1 sub def
        3 dup scale
    } ifelse
} def

/five {
    /depth exch def
    depth maxdepth ge
    {
        newpath 0 0 moveto -2 0 lineto stroke
        -2 0 translate
    }
    {
        1 3 div dup scale
        /newdepth depth 1 add def

        newdepth procs 0 get cvx exec
        newdepth procs 3 get cvx exec
        newdepth procs 2 get cvx exec
        newdepth procs 1 get cvx exec

        /newdepth newdepth 1 sub def
        3 dup scale
    } ifelse
} def

/magic 2 2 4 2 maxdepth exp 1 sub mul add 3 maxdepth exp div div def % magic scale factor
maxx 0.5 mul maxy 2 div maxx 0.4 mul add translate % initial origin...
maxx 0.8 mul 2 div magic mul dup scale % initial scale...

0 zero
0 one
0 zero
0 one

showpage
