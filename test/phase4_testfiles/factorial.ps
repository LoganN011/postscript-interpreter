/copy' {dup length array copy} def
/text 0 dict def
text
begin
	/f {C {dup /n get 1 le 
		{pop 1}
		{dup /f get exch dup /n get exch dup /f get exch dup /n get exch pop
		1 sub exch copy' dup 0 <</n 5 index /f 5 index>> put 
		cvx exec
		exch pop
		3 1 roll
		2 sub exch copy' dup 0 <</n 5 index /f 5 index>> put 
		cvx exec
		exch pop
		add}
		ifelse
		} exec} def
end
text /f get copy' dup 0 <</n 20 /f 5 index>> put cvx exec =
quit
