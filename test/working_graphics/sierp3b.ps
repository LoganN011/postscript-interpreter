%!
/setgray {dup dup setrgbcolor} def %%DS%%
0 setlinewidth
% lt l n Sierpk3Gasket
% Draw a thing inspired by the Sierpinski gasket recursivelly to a depth of N.
/Sierpk3Gasket
{
   dup 1 ne
   {
      % Recurse to draw 3 smaller ones first.
      gsave 0 2 index translate
      2 index 2 div 2 index 2 div 2 index 1 sub Sierpk3Gasket grestore
      gsave 120 rotate 0 2 index translate
      2 index 2 div 2 index 2 div 2 index 1 sub Sierpk3Gasket grestore
      gsave 240 rotate 0 2 index translate
      2 index 2 div 2 index 2 div 2 index 1 sub Sierpk3Gasket grestore
   } if
   % Draw a hollow triangle, blanking the inside out first.
   gsave
      newpath
      pop
      0 exch 2 copy moveto
      120 rotate 2 copy lineto
      120 rotate lineto
      closepath
      gsave 1 setgray fill grestore setlinewidth stroke
   grestore
} def

72 225 add 150 200 add translate
1.3 150 9 Sierpk3Gasket

showpage
