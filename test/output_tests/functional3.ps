/text 0 dict def

text
begin
	/f
	[
	    {%fn (c, x)
		[
		    {%fn (c, y)
			2
			1 index 1 get	%(select_1_a1 c)
			mul
			3
			3 index		%y
			mul
			add
			3 1 roll 2 {pop} repeat	%return
		    } %h'
		    3 index	%x
		]
		3 1 roll 2 {pop} repeat %return
	    } %d
	] def
end


/localdict 0 dict def

localdict
begin
    /g 3 text /f get dup 0 get exec def
    2 g dup 0 get exec
end
=

%prints 12
quit
