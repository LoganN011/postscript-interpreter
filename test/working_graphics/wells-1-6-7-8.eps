    0 0 0 setrgbcolor
    270 160 moveto show
} def
/presentinput
{
    0 0 1 setrgbcolor
    /Helvetica findfont 150 scalefont setfont
    10 60 moveto
    (i) show
    /Helvetica findfont 100 scalefont setfont
    0 -40 rmoveto
    show
    0 0 0 setrgbcolor
} def
/activewell
{
    1200 0 translate exec
    -600 0 translate exec
    -600 0 translate exec
    1200 700 translate exec
    -600 0 translate exec
    -600 0 translate exec
    1600 800 translate exec
    -300 0 translate exec
    -300 0 translate exec
    -300 0 translate exec
    -700 60 translate 50 0 moveto
    /Helvetica findfont 140 scalefont setfont
    show
    0 -1560 translate
} def
/offset
{
    dup 1 eq {pop -600} {2 eq {1000} {2600} ifelse} ifelse
} def
/activeboard_with_well_highlight
{
    newpath
    100 100 moveto
    5 setlinewidth
    1800 3 3 boardframe stroke
    3700 100 translate exec
    -1800 0 translate exec
    -1800 0 translate exec
    3600 1800 translate exec
    -1800 0 translate exec
    -1800 0 translate exec
    3600 1800 translate exec
    -1800 0 translate exec
    -1800 0 translate exec
    -100 -3700 translate
    offset exch offset exch
    2 copy translate
    2 2 scale
    3 -1 roll
    newpath 0 0 moveto 1800 square 1 1 1 setrgbcolor fill
    0 0 moveto 1800 square 0 0 0 setrgbcolor 10 setlinewidth stroke
    exec
    0.5 0.5 scale
    neg exch neg exch
    translate
} def
