    -3 3 36 mul 0.9 mul rlineto
    68 491 moveto
    -3 -3 36 mul 0.9 mul rlineto
    115 255 moveto
    0 180 rlineto
    stroke
    117 129 100 80 120 arcn
    stroke
    117 578 100 240 280 arcn
    stroke
    378 353.5 100 170 190 arcn
    stroke
    /Helvetica-Bold findfont 80 scalefont setfont
    85 420 moveto
    (F) show
    /Helvetica findfont 150 scalefont setfont
    0 0 0 setrgbcolor
    220 70 moveto show
    /Helvetica-Bold findfont 150 scalefont setfont
    1 0 0 setrgbcolor
    360 300 moveto show
    0 0.690 0 setrgbcolor
    90 70 moveto show
    90 540 moveto show
    0 0 0 setrgbcolor
} def
