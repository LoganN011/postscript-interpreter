/temp (123456789012345) def
123 10 temp cvrs ==
-123 10 temp cvrs ==
123.4 10 temp cvrs ==
123 16 temp cvrs ==
-123 16 temp cvrs ==
/temp 12 string def
clear
123.4 16 temp cvrs
dup
pstack
1 35 put pstack
temp  pstack
clear
(12) dup 1 35 put =

/str 20 string def
123 456 add str cvs = % 579
mark str cvs = % --nostringval--


1 type =
(abc) type =
{1 2 add} type =
{add} bind pstack 0 get type pstack
quit
