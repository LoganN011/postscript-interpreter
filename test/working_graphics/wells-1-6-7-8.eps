    /Helvetica-Bold findfont 150 scalefont setfont
    0 0.690 0 setrgbcolor
    90 70 moveto show
    90 540 moveto show
    0 0 0 setrgbcolor
} def
/plainyesgate
{
    newpath
    99 227 moveto
    3 {36 square 0 36 rmoveto} repeat
    36 36 rmoveto
    0 3 36 mul rlineto
    0 -4 36 mul rmoveto
    3 {36 square 36 0 rmoveto} repeat
    stroke
    117 129 100 80 100 arcn
    stroke
    /Helvetica findfont 150 scalefont setfont
    280 70 moveto show
    /Helvetica-Bold findfont 150 scalefont setfont
    0 0.690 0 setrgbcolor
    90 70 moveto show
    0 0 0 setrgbcolor
} def
/plainonegate
{
    newpath
    135 227 moveto
    0 7 36 mul rlineto
    0 -4 36 mul rmoveto
    3 {36 square 36 0 rmoveto} repeat
    stroke
    /Helvetica findfont 150 scalefont setfont
    270 160 moveto show
} def
/activeandandnotgate
{
    newpath
    3 setlinewidth
