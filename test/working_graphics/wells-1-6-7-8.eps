%!PS-Adobe-3.0 EPSF-3.0

0.1 0.1 scale



64 dict begin
/findfont {} def %%DS%%
/scalefont {pop} def %%DS%%
/setfont {pop} def %%DS%%
/show {pop} def %%DS%%

/square
{
    dup 0 rlineto
    dup 0 exch rlineto
    0 exch sub 0 rlineto
    closepath
} def
/rowframe
{
    {
	dup square
	dup 0 rmoveto
    }
    repeat
    pop
} def
/boardframe
{
    {
	currentpoint 4 2 roll 2 copy rowframe 4 2 roll moveto
	exch dup 0 exch rmoveto exch
    }
    repeat
    pop pop
} def
/plainandandnotgate
{
    newpath
    99 227 moveto
    3 {36 square 0 36 rmoveto} repeat
    0 36 rmoveto
    3 {36 square 0 36 rmoveto} repeat
    36 -4 36 mul rmoveto
    4 {36 square 36 0 rmoveto} repeat
    stroke
    117 129 100 80 100 arcn
    stroke
    117 578 100 260 280 arcn
    stroke
    378 353.5 100 170 190 arcn
    stroke
    /Helvetica findfont 150 scalefont setfont
    220 70 moveto show
    /Helvetica-Bold findfont 150 scalefont setfont
    1 0 0 setrgbcolor
    360 300 moveto show
    0 0.690 0 setrgbcolor
    90 70 moveto show
    90 540 moveto show
    0 0 0 setrgbcolor
} def
/plainandgate
{
    newpath
    99 227 moveto
    3 {36 square 0 36 rmoveto} repeat
