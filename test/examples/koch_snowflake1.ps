%!PS
%%BoundingBox: 94 80 521 568
0 setlinewidth
/side {
    dup % store current depth
    0 gt % test if at 0 yet
    {
        1 sub % reduce depth by 1
        1 3 div dup scale % scale to 1/3
        side 60 rotate side -120 rotate side 60 rotate side % draw one side as components
        3 dup scale % scale back up
        1 add % restore prev depth to stack
    }
    {
        newpath 0 0 moveto 1 1 lineto stroke 1 1 translate % draw line from 0,0 to 1,1 in current coordinate system
    }
    ifelse
} bind def

/star { % draw initial triangle
    side 
    -120 rotate side
    -120 rotate side
    pop % clear stack
} bind def

100 200 translate
300 300 scale
15 rotate
6 star
showpage
